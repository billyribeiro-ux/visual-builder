{
  "name": "app-viz-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build && pnpm -r --filter \"./apps/*\" run build",
    "dev": "pnpm --filter @app-viz/studio dev",
    "test": "pnpm -r run test",
    "test:unit": "vitest run",
    "test:parity": "tsx tests/e2e-parity-check.ts",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r run typecheck",
    "audit:svelte": "tsx scripts/audit-svelte.ts"
  },
  "devDependencies": {
    "@sveltejs/mcp": "^0.1.28",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0"
  }
}
