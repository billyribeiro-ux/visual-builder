{
  "name": "app-viz-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build && pnpm -r --filter \"./apps/*\" run build",
    "dev": "pnpm --filter @app-viz/studio dev",
    "test": "pnpm -r run test",
    "test:unit": "vitest run",
    "test:parity": "tsx tests/e2e-parity-check.ts",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.0",
    "vitest": "^3.0.4"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.17.0"
  }
}
